---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import EmptyState from "@/components/EmptyState.astro";
import { articleCategories, articles } from "@/data/articles";
---

<BaseLayout title="Articles / Reports" description="Reusable output list for articles, reports, presentations, books, chapters, media, and news.">
  <PageHeader
    eyebrow="Articles / Reports"
    title="Outputs and Publications Framework"
    description="Demo / Placeholder: records are layout examples only. Replace them with verified citation data."
    breadcrumbs={[{ label: "Articles / Reports" }]}
  />

  {articleCategories.map((category) => {
    const records = articles.filter((article) => article.category === category);
    return (
      <section class="section">
        <div class="container">
          <SectionHeading
            eyebrow="Output Category"
            title={category}
            description="Each record supports title, authors, year, category, citation, summary, thumbnail, PDF URL, and external URL."
          />
          <div class="record-stack">
            {records.length ? records.map((article) => <ArticleCard article={article} />) : (
              <EmptyState title="Content pending" description="No demo record has been added for this category yet." />
            )}
          </div>
        </div>
      </section>
    );
  })}
</BaseLayout>

<style>
  .section:nth-of-type(odd) {
    background: rgba(255, 255, 255, 0.5);
  }

  .record-stack {
    display: grid;
    gap: 18px;
    margin-top: 28px;
  }
</style>
