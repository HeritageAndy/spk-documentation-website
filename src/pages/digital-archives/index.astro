---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ImagePlaceholder from "@/components/ImagePlaceholder.astro";
import MonumentCard from "@/components/MonumentCard.astro";
import EmptyState from "@/components/EmptyState.astro";
import { externalSystems } from "@/config/externalSystems";
import { monuments } from "@/data/monuments";
import { thematicCollections } from "@/data/collections";
import { withBase } from "@/utils/paths";
---

<BaseLayout title="Digital Archives" description="Digital Archives framework with map, monument inventory, collections, and search placeholders.">
  <PageHeader
    eyebrow="Digital Archives"
    title="Map, Monument, and Collection Framework"
    description="Demo / Placeholder: this page prepares replaceable areas for future GIS maps, monument inventory, thematic collections, search, and external systems."
    breadcrumbs={[{ label: "Digital Archives" }]}
  />

  <section class="section-tight archive-jump">
    <div class="container grid grid-4">
      <a class="jump-card" href="#interactive-map">Interactive Map</a>
      <a class="jump-card" href="#monument-inventory">Monument Inventory</a>
      <a class="jump-card" href="#thematic-collections">Thematic Collections</a>
      <a class="jump-card" href="#search-placeholder">Search Placeholder</a>
    </div>
  </section>

  <section class="section" id="interactive-map">
    <div class="container">
      <SectionHeading
        eyebrow="Interactive Map"
        title="Interactive map gateway"
        description="The project QGIS web map is available as a dedicated page so the map has enough screen space and the Digital Archives overview remains lightweight."
      />
      <article class="card map-gateway">
        <div class="map-preview" aria-hidden="true">
          <span>QGIS Web Map</span>
        </div>
        <div class="card-pad">
          <p class="eyebrow">Map developed by project team</p>
          <h3>{externalSystems.interactiveMap.label}</h3>
          <p>{externalSystems.interactiveMap.description}</p>
          <div class="map-actions">
            <a class="button" href={withBase("/interactive-map")}>Open Interactive Map</a>
            <a class="button secondary" href={externalSystems.interactiveMap.url} target="_blank" rel="noreferrer">
              Open Original Map
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section inventory-band" id="monument-inventory">
    <div class="container">
      <SectionHeading
        eyebrow="Monument Inventory"
        title="Reusable monument card template"
        description="Demo records only. Future verified content should be edited in the monument data file, not by duplicating full pages."
      />
      <div class="grid grid-4 card-row">
        {monuments.map((monument) => <MonumentCard monument={monument} />)}
      </div>
    </div>
  </section>

  <section class="section" id="thematic-collections">
    <div class="container">
      <SectionHeading
        eyebrow="Thematic Collections"
        title="Collection entry points"
        description="Each card can later link to an internal page, external team system, or embedded iframe controlled by configuration."
      />
      <div class="grid grid-4 card-row">
        {thematicCollections.map((collection) => (
          <article class="card collection-card">
            <ImagePlaceholder label={collection.title} alt={`Cover placeholder for ${collection.title}`} />
            <div class="card-pad">
              <h3>{collection.title}</h3>
              <p>{collection.summary}</p>
              <a class="button secondary" href={withBase(collection.internalHref)}>View Collection</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section search-band" id="search-placeholder">
    <div class="container grid grid-2">
      <SectionHeading
        eyebrow="Search"
        title="Future search system connection"
        description="No artifact search system is developed in this phase. This placeholder will later connect to the team database or external retrieval system."
      />
      <EmptyState
        title="Search under preparation"
        description="Content pending: the future search system can be linked or embedded through the external system configuration."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .archive-jump {
    border-bottom: 1px solid var(--color-line);
    background: rgba(255, 255, 255, 0.55);
  }

  .jump-card {
    display: flex;
    align-items: center;
    min-height: 76px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: white;
    padding: 18px;
    color: var(--color-earth-dark);
    font-weight: 850;
    text-decoration: none;
  }

  .jump-card:hover {
    border-color: var(--color-earth);
  }

  .system-wrap,
  .card-row {
    margin-top: 28px;
  }

  .map-gateway {
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) minmax(0, 1.15fr);
    margin-top: 28px;
    overflow: hidden;
  }

  .map-preview {
    display: grid;
    min-height: 260px;
    place-items: center;
    border-right: 1px solid var(--color-line);
    background:
      linear-gradient(90deg, rgba(73, 111, 130, 0.12) 1px, transparent 1px),
      linear-gradient(0deg, rgba(73, 111, 130, 0.12) 1px, transparent 1px),
      linear-gradient(135deg, rgba(82, 107, 84, 0.2), rgba(255, 255, 255, 0.28)),
      #e8eee8;
    background-size: 38px 38px, 38px 38px, auto, auto;
    color: var(--color-river);
    font-weight: 900;
  }

  .map-gateway h3 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.3rem);
  }

  .map-gateway p:not(.eyebrow) {
    color: var(--color-muted);
    line-height: 1.7;
  }

  .map-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }

  .inventory-band,
  .search-band {
    border-block: 1px solid var(--color-line);
    background: rgba(255, 255, 255, 0.5);
  }

  .collection-card {
    overflow: hidden;
  }

  h3 {
    margin: 0;
  }

  .collection-card p {
    color: var(--color-muted);
    line-height: 1.65;
  }

  @media (max-width: 820px) {
    .map-gateway {
      grid-template-columns: 1fr;
    }

    .map-preview {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
  }
</style>
