---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { homepageIntroduction, projectTimeline } from "@/data/home";
import { siteInfo } from "@/config/site";
import { withBase } from "@/utils/paths";
---

<BaseLayout title="Home" description={siteInfo.description}>
  <section class="home-hero" style={`--hero-image: url('${withBase("/images/prasat-sambor-n1.jpg")}')`}>
    <div class="hero-overlay"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>{siteInfo.name}</h1>
        <p>{homepageIntroduction}</p>
        <div class="hero-actions">
          <a class="button" href={withBase("/story")}>Explore the Story</a>
          <a class="button secondary" href={withBase("/digital-archives")}>Explore the Digital Archives</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2 entry-grid">
      <article class="entry-card story-entry">
        <p class="eyebrow">Guided Browsing</p>
        <h2>Story</h2>
        <p>
          Placeholder: a structured route for visitors to follow future historical,
          architectural, urban, religious, research, and conservation narratives.
        </p>
        <a class="button" href={withBase("/story")}>Explore the Story</a>
      </article>
      <article class="entry-card archive-entry">
        <p class="eyebrow">Map and Archive Exploration</p>
        <h2>Digital Archives</h2>
        <p>
          Placeholder: an archive gateway prepared for future maps, monument pages,
          thematic collections, databases, and digital documentation outputs.
        </p>
        <a class="button" href={withBase("/digital-archives")}>Explore the Digital Archives</a>
      </article>
    </div>
  </section>

  <section class="section project-band">
    <div class="container">
      <div class="timeline-heading">
        <p class="eyebrow">Project History</p>
        <h2>Historical and project timeline</h2>
      </div>
      <div class="timeline" aria-label="Project history timeline">
        {projectTimeline.map((item, index) => (
          <article class:list={["timeline-item", item.position]}>
            <div class="timeline-content">
              <span class="timeline-period">{item.period}</span>
              <h3>{item.title}</h3>
              {item.description && <p>{item.description}</p>}
            </div>
            <span class:list={["timeline-dot", { short: index === 1, dashed: index === 2 }]}></span>
          </article>
        ))}
      </div>
      <a class="button secondary timeline-link" href={withBase("/project")}>View Project Framework</a>
    </div>
  </section>

  <section class="section cesium-band">
    <div class="container">
      <article class="cesium-entry">
        <div>
          <p class="eyebrow">Interactive 3D Archive</p>
          <h2>Explore the Cesium 3D Models</h2>
          <p>
            Browse the photogrammetric documentation of Sambor Prei Kuk in its spatial
            context and open the archive record linked to each monument.
          </p>
        </div>
        <a class="button" href={withBase("/cesium/")}>Open the 3D Viewer</a>
      </article>
    </div>
  </section>

  <section class="section members-band">
    <div class="container">
      <article class="members-card card card-pad">
        <p class="eyebrow">Members</p>
        <h2>Content pending</h2>
        <p class="muted">This large section is reserved for the project member text that will be added later.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: calc(100vh - 76px);
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background-image: var(--hero-image);
    background-position: center;
    background-size: cover;
    color: white;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(18, 24, 21, 0.8), rgba(18, 24, 21, 0.38) 52%, rgba(18, 24, 21, 0.18)),
      linear-gradient(0deg, rgba(18, 24, 21, 0.84), transparent 48%);
  }

  .hero-grid {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: calc(100vh - 76px);
    padding-block: 52px;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(2.7rem, 7vw, 6rem);
    line-height: 0.98;
  }

  .hero-copy p:not(.eyebrow) {
    max-width: 840px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .hero-actions .button.secondary {
    border-color: rgba(255, 255, 255, 0.78);
    color: white;
  }

  .entry-card {
    min-height: 320px;
    border-radius: var(--radius);
    padding: 30px;
    color: white;
  }

  .story-entry {
    background:
      linear-gradient(135deg, rgba(38, 49, 44, 0.92), rgba(93, 61, 45, 0.9)),
      #26312c;
  }

  .archive-entry {
    background:
      linear-gradient(135deg, rgba(73, 111, 130, 0.94), rgba(82, 107, 84, 0.92)),
      #496f82;
  }

  .entry-card .eyebrow,
  .entry-card p {
    color: rgba(255, 255, 255, 0.82);
  }

  .entry-card h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.1rem);
  }

  .entry-card .button {
    margin-top: 18px;
    border-color: white;
    background: white;
    color: var(--color-ink);
  }

  .project-band,
  .members-band {
    border-block: 1px solid var(--color-line);
    background: rgba(255, 255, 255, 0.5);
  }

  .cesium-band {
    border-bottom: 1px solid var(--color-line);
    background: #26312c;
    color: white;
  }

  .cesium-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 36px;
    min-height: 260px;
    border-left: 2px solid #c0a272;
    padding: 34px 38px;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.055), transparent 60%),
      #26312c;
  }

  .cesium-entry .eyebrow,
  .cesium-entry p {
    color: rgba(255, 255, 255, 0.78);
  }

  .cesium-entry h2 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .cesium-entry p:not(.eyebrow) {
    max-width: 760px;
    margin-bottom: 0;
    line-height: 1.75;
  }

  .cesium-entry .button {
    border-color: white;
    background: white;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .timeline-heading {
    max-width: 760px;
  }

  .timeline-heading h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
  }

  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(120px, 1fr));
    min-height: 360px;
    margin-top: 44px;
    overflow-x: auto;
    padding: 24px 0 30px;
  }

  .timeline::before {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    background:
      linear-gradient(90deg, var(--color-earth-dark) 0 13%, transparent 13% 36%, var(--color-line) 36% 100%);
    content: "";
  }

  .timeline::after {
    position: absolute;
    left: 30%;
    right: 64%;
    top: 50%;
    border-top: 2px dashed var(--color-earth-dark);
    content: "";
  }

  .timeline-item {
    position: relative;
    min-width: 140px;
  }

  .timeline-content {
    position: absolute;
    left: 0;
    width: min(220px, 100%);
    border-left: 2px solid rgba(140, 95, 63, 0.38);
    padding-left: 14px;
  }

  .timeline-item.top .timeline-content {
    bottom: calc(50% + 38px);
  }

  .timeline-item.bottom .timeline-content {
    top: calc(50% + 38px);
  }

  .timeline-period {
    color: var(--color-earth-dark);
    font-size: 0.9rem;
    font-weight: 900;
  }

  .timeline h3 {
    margin: 5px 0 0;
    font-size: 1rem;
    line-height: 1.25;
  }

  .timeline p {
    margin: 8px 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .timeline-dot {
    position: absolute;
    left: 0;
    top: 50%;
    width: 14px;
    height: 14px;
    transform: translateY(-6px);
    border: 3px solid white;
    border-radius: 50%;
    background: var(--color-earth-dark);
    box-shadow: 0 0 0 1px rgba(140, 95, 63, 0.35);
  }

  .timeline-link {
    margin-top: 10px;
  }

  .members-card {
    min-height: 300px;
    display: grid;
    align-content: start;
  }

  .members-card h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  @media (max-width: 900px) {
    .hero-grid {
      min-height: auto;
    }

    .home-hero {
      min-height: 680px;
    }

    .timeline {
      grid-template-columns: repeat(6, 180px);
    }

    .cesium-entry {
      grid-template-columns: 1fr;
      align-items: start;
      padding: 30px 26px;
    }

    .cesium-entry .button {
      justify-self: start;
    }
  }
</style>
