---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { storySections } from "@/data/story";
import { externalSystems } from "@/config/externalSystems";

const storyCards = storySections.map((section) => {
  const key = section.externalSystemKey as keyof typeof externalSystems | "";
  const externalSystem = key ? externalSystems[key] : null;
  return { ...section, externalSystem };
});
---

<BaseLayout title="Story" description="Story page framework for future guided browsing and Cesium Stories integration.">
  <PageHeader
    eyebrow="Story"
    title="Guided Story Framework"
    description="Demo / Placeholder: future Cesium Stories and guided chapters will be connected here after verified content is prepared."
    breadcrumbs={[{ label: "Story" }]}
  />

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Cesium Stories"
        title="Four guided story sections"
        description="Each horizontal section is prepared as a direct entry to a future Cesium Story. Available stories open externally; pending stories keep a clear preparation state."
      />
      <div class="chapter-list">
        {storyCards.map((section, index) => (
          <article class="card chapter-card">
            <span class="chapter-number">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2>{section.title}</h2>
              <p>{section.summary}</p>
            </div>
            {section.externalSystem?.url ? (
              <a
                class="button"
                href={section.externalSystem.url}
                target="_blank"
                rel="noreferrer"
              >
                Browse Cesium Story
              </a>
            ) : (
              <span class="button disabled" aria-disabled="true">Under preparation</span>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .chapter-list {
    display: grid;
    gap: 18px;
    margin-top: 28px;
  }

  .chapter-card {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr) auto;
    gap: 22px;
    align-items: center;
    min-height: 148px;
    padding: 24px;
  }

  .chapter-number {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border: 1px solid rgba(73, 111, 130, 0.3);
    border-radius: 50%;
    background: rgba(73, 111, 130, 0.08);
    color: var(--color-river);
    font-size: 0.9rem;
    font-weight: 900;
  }

  h2 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.25;
  }

  p {
    color: var(--color-muted);
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .chapter-card {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
