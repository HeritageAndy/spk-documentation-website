---
import { navigationItems } from "@/config/navigation";
import { siteInfo } from "@/config/site";
import { withBase } from "@/utils/paths";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(base, "") || "/";

function isActive(href: string) {
  return href === "/" ? currentPath === "/" : currentPath.startsWith(href);
}
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase("/")} aria-label={`${siteInfo.name} home`}>
      <span class="brand-mark" aria-hidden="true">SPK</span>
      <span>
        <span class="brand-kicker">Documentation Website</span>
        <span class="brand-title">Sambor Prei Kuk</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {navigationItems.map((item) => (
        <a class:list={["nav-link", { active: isActive(item.href) }]} href={withBase(item.href)}>
          {item.label}
        </a>
      ))}
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Open navigation">Menu</summary>
      <nav aria-label="Mobile navigation">
        {navigationItems.map((item) => (
          <a class:list={["mobile-link", { active: isActive(item.href) }]} href={withBase(item.href)}>
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    border-radius: 6px;
    background: var(--color-river);
    color: white;
    padding: 10px 14px;
    font-weight: 700;
  }

  .skip-link:focus {
    top: 12px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-line);
    background: rgba(247, 245, 239, 0.95);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    gap: 12px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 6px;
    background: var(--color-earth-dark);
    color: white;
    font-weight: 800;
  }

  .brand-kicker {
    display: block;
    color: var(--color-muted);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .brand-title {
    display: block;
    font-size: 1rem;
    font-weight: 800;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    border-radius: 6px;
    padding: 10px 11px;
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 750;
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link.active {
    background: rgba(140, 95, 63, 0.1);
    color: var(--color-earth-dark);
  }

  .mobile-nav {
    display: none;
    position: relative;
  }

  .mobile-nav summary {
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 11px 14px;
    color: var(--color-earth-dark);
    font-weight: 800;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav nav {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: min(84vw, 310px);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    padding: 8px;
  }

  .mobile-link {
    display: block;
    border-radius: 6px;
    padding: 12px;
    color: var(--color-ink);
    font-weight: 750;
    text-decoration: none;
  }

  .mobile-link.active {
    background: rgba(140, 95, 63, 0.1);
    color: var(--color-earth-dark);
  }

  @media (max-width: 980px) {
    .desktop-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }

  @media (max-width: 520px) {
    .brand-kicker {
      display: none;
    }

    .brand-title {
      max-width: 160px;
      overflow-wrap: anywhere;
      line-height: 1.15;
    }
  }
</style>
