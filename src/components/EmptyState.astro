---
const { title = "Under preparation", description = "Content pending." } = Astro.props;
---

<div class="empty-state">
  <h3>{title}</h3>
  <p>{description}</p>
</div>

<style>
  .empty-state {
    border: 1px dashed var(--color-line);
    border-radius: var(--radius);
    padding: 22px;
    background: rgba(255, 255, 255, 0.62);
  }

  h3 {
    margin: 0 0 8px;
  }

  p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.7;
  }
</style>
